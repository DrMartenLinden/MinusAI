{
  "manifest_version": 3,
  "name": "Minus AI",
  "version": "1.1",
  "description": "Automatically appends '-AI' to your Google searches. Click the extension icon to toggle on/off.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_title": "Minus AI (Active)"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.google.com/search*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
